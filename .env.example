# Copia este archivo a .env y rellena UNA key (la primera que encuentre gana).
# Orden: GROQ → GEMINI → OPENROUTER → XAI → OPENAI

# Recomendado gratis: https://console.groq.com
GROQ_API_KEY=

# Gratis: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Modelos free: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# https://console.x.ai
# XAI_API_KEY=

# https://platform.openai.com
# OPENAI_API_KEY=

# Opcional: forzar modelo (ej. llama-3.3-70b-versatile, gemini-2.0-flash)
# LLM_MODEL=
